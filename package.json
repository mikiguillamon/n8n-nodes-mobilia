{
  "name": "n8n-nodes-mobilia",
  "version": "0.1.9",
  "description": "Community node for using the Mobilia API from n8n",
  "license": "MIT",
  "homepage": "https://api.mobiliagestion.es/swagger/index.html",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "mobilia",
    "crm",
    "real-estate"
  ],
  "author": {
    "name": "Miki Guillamon"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mikiguillamon/n8n-nodes-mobilia.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/MobiliaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Mobilia/Mobilia.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.28.0",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.0.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
